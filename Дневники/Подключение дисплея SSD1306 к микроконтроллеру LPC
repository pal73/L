#include <LPC17xx.h>
#include "LPC17xx_I2C.h"
#include "u8g2.h"

// Инициализация I2C
void i2cInit() {
    LPC_I2C0->SCLH = 3; // SCLH период (в часах)
    LPC_I2C0->SCLL = 3; // SCLH период (в часах)
}

// Функция для записи данных в I2C
void i2cWrite(uint8_t address, uint8_t* data, uint16_t length) {
    LPC_I2C0->ADR = address << 1; // Установка адреса устройства
    while (LPC_I2C0->STAT & I2C_STAT_XFRDONE); // Ожидание завершения предыдущей передачи
    LPC_I2C0->DAT = *data++; // Запись данных
    while (!(LPC_I2C0->STAT & I2C_STAT_XFERACK)); // Ожидание подтверждения
}

// Инициализация SSD1306
void ssd1306Init(uint8_t address) {
    uint8_t cmds[] = {
        0xAE, // Display Off
        0xD5, 0x20, // Set Clock Divider
        0xA8, 0x3F, // Set Multiplex Ratio
        0xD3, 0x14, // Set Display Offset
        0x40, // Set Start Line
        0xA1, // Set Segment Re-map
        0xC8, // Set COM Output Scan Direction
        0xDA, 0x12, // Set COM Pins Hardware Configuration
        0x81, 0xCF, // Set Contrast Control
        0xD9, 0xF1, // Set Precharge Period
        0xDB, 0x30, // Set VCOMH Deselect Level
        0xA4, // Entire Display ON
        0xA6, // Normal/Inverse Display Mode
        0x2E, // Deactivate Scroll
        0x20, 0x00, // Set Memory Addressing Mode
        0x21, 0x00, 0x7F, // Set Column Address
        0x22, 0x00, 0x3F, // Set Page Address
        0xAF // Display ON
    };
    
    for (uint8_t i = 0; i < sizeof(cmds); i++) {
        i2cWrite(address, &cmds[i], 1);
    }
}

// Функция для очистки дисплея
void clearDisplay() {
    uint8_t cmds[] = {0xB0, 0x00, 0x7F, 0x21, 0x00, 0x7F, 0x22, 0x00, 0x3F};
    for (uint8_t i = 0; i < sizeof(cmds); i++) {
        i2cWrite(0x3C, &cmds[i], 1);
    }
}

// Основная функция
int main() {
    // Инициализация системы
    SystemInit();
    SysTick_Config(SystemCoreClock / 1000);
    
    // Инициализация I2C
    i2cInit();
    
    // Инициализация SSD1306
    ssd1306Init(0x3C);
    
    // Очистка дисплея
    clearDisplay();
    
    while (1) {
        // Ваш основной цикл
    }
}
Объяснение:


i2cInit(): Инициализация I2C с заданными периодами SCLH и SCLH.

i2cWrite(): Функция для записи данных в I2C устройство.

ssd1306Init(): Инициализация SSD1306 дисплея с помощью команд инициализации.

clearDisplay(): Очистка дисплея.

main(): Основная функция, где происходит инициализация и запуск работы с дисплеем.


Заключение:

Этот пример кода демонстрирует базовую работу с SSD1306 дисплеем через I2C на микроконтроллере LPC17XX в среде разработки KEIL ARM. Вы можете расширить этот код для отображения текста, графики и других функций в зависимости от ваших требований.


